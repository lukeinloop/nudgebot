+def hours_late(assignment: Mapping[str, Any] | None) -> float:
+    """
+    Get how many hours after the deadline an assignment was submitted.
+
+    :param assignment: Same format as submission_status().
+    :type assignment: Mapping[str, Any] | None
+    :return: Hours late, or 0.0 if the assignment is on time or not submitted.
+    :rtype: float
+    """
+    if assignment is None or submission_status(assignment) != "late":
+        return 0.0
+
+    delta = assignment["submitted_at"] - assignment["due"]
+    return float(delta.total_seconds() / 3600)
